# Root-level artifact directories only.
# Leading "/" anchors each to the repo root, so same-named code packages
# (src/bev/data, src/bev/viz) stay tracked.
/.venv/
/data/
/out/
/models/
/viz/

# Python / Jupyter / tool caches (safe to ignore at any depth)
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# OS / editor cruft
.DS_Store
CLAUDE.md